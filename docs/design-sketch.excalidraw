    {
      "id": "7S0E8Afa1KpuEH0C-E1ue",
      "type": "text",
      "x": 146.16946752679837,
      "y": 337.1102929225432,
      "width": 1412.718994140625,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aB",
      "roundness": null,
      "seed": 1977932910,
      "version": 650,
      "versionNonce": 1808169134,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795131299087,
      "created": 1795130918368,
      "link": null,
      "locked": false,
      "text": "1. multi turn -> collecting information before responding -> name, phone number, email, -> anything more would be too much friction\n2. action -> email or phone number notifications or confirmations of the order status inquiry or return/refund requests, passwords resets\n3. clarifying question -> why are you refunding? capture cancellation reason, capture how you would it refunded -> try and push for store credit \n\n\n\n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. multi turn -> collecting information before responding -> name, phone number, email, -> anything more would be too much friction\n2. action -> email or phone number notifications or confirmations of the order status inquiry or return/refund requests, passwords resets\n3. clarifying question -> why are you refunding? capture cancellation reason, capture how you would it refunded -> try and push for store credit \n\n\n\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
