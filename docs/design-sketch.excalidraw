      "link": null,
      "locked": false,
      "text": "user: where is my order?\nAI : getOrderNUmber(), \nif there's more than 1 book,  confirm book\nvia title, author, with user\nuser: confirms\nAI: return orderStatus()\n\nanything else gets routed to a live human\nagent\n\n",
      "fontSize": 19.997112260970283,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "user: where is my order?\nAI : getOrderNUmber(), \nif there's more than 1 book,  confirm book via title, author, with user\nuser: confirms\nAI: return orderStatus()\n\nanything else gets routed to a live human agent\n\n",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
