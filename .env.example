# Copy to .env and fill in. Never commit .env.

# Anthropic
ANTHROPIC_API_KEY=
BOOKLY_MODEL=claude-opus-5-5
BOOKLY_EFFORT=low   # every published result was measured at low; see README
# Off by default: a refusal hands off to a human. Set 1 to retry on a fallback model instead.
BOOKLY_REFUSAL_FALLBACK=0
# Latency levers (on by default; measured in the README decisions log)
BOOKLY_PREFETCH=1
BOOKLY_TERMINAL_SAY=1
# Model used to play the caller in simulations
BOOKLY_SIM_MODEL=claude-opus-5-5

# AssemblyAI (streaming STT)
ASSEMBLYAI_API_KEY=

# Cartesia (TTS)
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+18382322421
TRANSFER_NUMBER=

# Public host for Twilio webhooks / media stream (your ngrok static domain, no scheme)
PUBLIC_HOST=

# Optional voice tuning
# ASSEMBLYAI_MODE=balanced   # min_latency | balanced | max_accuracy
# CARTESIA_MODEL=sonic-3.6
